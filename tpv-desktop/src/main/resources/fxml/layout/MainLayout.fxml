<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tpv.desktop.ui.layout.MainLayoutController"
            stylesheets="@../../styles/tpv.css"
            prefWidth="1200" prefHeight="750">

  <top>
    <fx:include fx:id="topBar" source="../components/TopBar.fxml"/>
  </top>

  <left>
    <VBox spacing="10" styleClass="sidebar">
      <Label text="BARIX TPV" styleClass="sidebar-title"/>

      <Button text="Salon" onAction="#goSalon" maxWidth="Infinity"/>
      <Button text="Sales" onAction="#goSales" maxWidth="Infinity"/>
      <Button text="Cash Register" onAction="#goCash" maxWidth="Infinity"/>
      <Button text="Tickets History" onAction="#goHistory" maxWidth="Infinity"/>
      <Button text="Fiscal Summary" onAction="#goFiscal" maxWidth="Infinity"/>
      <Button text="Fiscal Closure" onAction="#goFiscalClosure" maxWidth="Infinity"/>
      <Button text="Settings" onAction="#goSettings" maxWidth="Infinity"/>

      <Region VBox.vgrow="ALWAYS"/>
      <Button text="Logout" onAction="#logout" maxWidth="Infinity"/>
    </VBox>
  </left>

  <center>
    <StackPane fx:id="content" styleClass="content-area">
      <Label text="Loading..."/>
    </StackPane>
  </center>
</BorderPane>
