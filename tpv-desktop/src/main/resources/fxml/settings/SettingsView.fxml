<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tpv.desktop.ui.settings.SettingsController"
            prefWidth="1100" prefHeight="650">

  <top>
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 12;">
      <Label text="Settings" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    </HBox>
  </top>

  <center>
    <ScrollPane fitToWidth="true">
      <content>
        <VBox spacing="12" style="-fx-padding: 12;">
          <Label text="API Base URL (Gateway)"/>
          <TextField fx:id="apiBaseUrlField" promptText="http://localhost:8080" prefWidth="420"/>

          <Label text="Terminal ID"/>
          <TextField fx:id="terminalIdField" promptText="TERMINAL-BARRA" prefWidth="420"/>

          <Label text="Nombre del negocio"/>
          <TextField fx:id="restaurantNameField" promptText="Restaurante EL GUSTO" prefWidth="420"/>

          <TitledPane text="Datos fiscales" expanded="false">
            <GridPane hgap="10" vgap="10" style="-fx-padding: 10;">
              <Label text="Razon social" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
              <TextField fx:id="fiscalLegalNameField"
                         promptText="Restaurante El Gusto S.L."
                         GridPane.rowIndex="0"
                         GridPane.columnIndex="1"
                         prefWidth="360"/>

              <Label text="NIF/CIF" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
              <TextField fx:id="fiscalTaxIdField"
                         promptText="B12345678"
                         GridPane.rowIndex="1"
                         GridPane.columnIndex="1"
                         prefWidth="200"/>

              <Label text="Direccion fiscal" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
              <TextField fx:id="fiscalAddressField"
                         promptText="Calle Mayor 1"
                         GridPane.rowIndex="2"
                         GridPane.columnIndex="1"
                         prefWidth="360"/>

              <Label text="Codigo postal" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
              <TextField fx:id="fiscalPostalCodeField"
                         promptText="28001"
                         GridPane.rowIndex="3"
                         GridPane.columnIndex="1"
                         prefWidth="120"/>

              <Label text="Ciudad" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
              <TextField fx:id="fiscalCityField"
                         promptText="Madrid"
                         GridPane.rowIndex="4"
                         GridPane.columnIndex="1"
                         prefWidth="220"/>

              <Label text="Provincia" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
              <TextField fx:id="fiscalProvinceField"
                         promptText="Madrid"
                         GridPane.rowIndex="5"
                         GridPane.columnIndex="1"
                         prefWidth="220"/>

              <Label text="Pais (ISO)" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
              <TextField fx:id="fiscalCountryField"
                         promptText="ES"
                         GridPane.rowIndex="6"
                         GridPane.columnIndex="1"
                         prefWidth="80"/>

              <Label text="Telefono fiscal" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
              <TextField fx:id="fiscalPhoneField"
                         promptText="+34 600 000 000"
                         GridPane.rowIndex="7"
                         GridPane.columnIndex="1"
                         prefWidth="180"/>

              <Label text="Email fiscal" GridPane.rowIndex="8" GridPane.columnIndex="0"/>
              <TextField fx:id="fiscalEmailField"
                         promptText="facturacion@negocio.com"
                         GridPane.rowIndex="8"
                         GridPane.columnIndex="1"
                         prefWidth="280"/>
            </GridPane>
          </TitledPane>

          <TitledPane text="Impresoras" expanded="true">
            <VBox spacing="10" style="-fx-padding: 10;">
              <Label text="Configura impresoras del negocio y asigna a impresoras reales del sistema."/>

              <TableView fx:id="printersTable" prefHeight="180">
                <columns>
                  <TableColumn fx:id="printerLogicalCol" text="Impresora negocio" prefWidth="230"/>
                  <TableColumn fx:id="printerDestinationCol" text="Destino" prefWidth="110"/>
                  <TableColumn fx:id="printerSystemCol" text="Impresora sistema" prefWidth="340"/>
                  <TableColumn fx:id="printerEnabledCol" text="Activa" prefWidth="80"/>
                </columns>
              </TableView>

              <GridPane hgap="10" vgap="8">
                <Label text="Nombre" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="printerLogicalNameField"
                           promptText="Cocina principal"
                           GridPane.rowIndex="0"
                           GridPane.columnIndex="1"
                           prefWidth="220"/>

                <Label text="Destino" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                <ComboBox fx:id="printerDestinationCombo"
                          GridPane.rowIndex="0"
                          GridPane.columnIndex="3"
                          prefWidth="140"/>

                <Label text="Impresora real" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <ComboBox fx:id="systemPrinterCombo"
                          GridPane.rowIndex="1"
                          GridPane.columnIndex="1"
                          GridPane.columnSpan="3"
                          prefWidth="520"/>

                <CheckBox fx:id="printerEnabledCheck"
                          text="Activa"
                          GridPane.rowIndex="2"
                          GridPane.columnIndex="1"/>
              </GridPane>

              <HBox spacing="10">
                <Button text="Nueva" onAction="#onPrinterNew"/>
                <Button text="Guardar impresora" onAction="#onPrinterSave"/>
                <Button text="Eliminar" onAction="#onPrinterDelete"/>
                <Button text="Recargar impresoras sistema" onAction="#onRefreshSystemPrinters"/>
                <Button text="Test impresion" onAction="#onPrinterTest"/>
              </HBox>
            </VBox>
          </TitledPane>

          <HBox spacing="10">
            <Button text="Guardar" onAction="#onSave"/>
            <Button text="Test conexion" onAction="#onTest"/>
            <Button text="Reset Terminal ID" onAction="#onResetTerminalId"/>
            <Button text="Liberar mis bloqueos" onAction="#onReleaseOwnLocks"/>
            <Button text="Abrir logs red" onAction="#onOpenConnectivityLogs"/>
            <Button text="Limpiar logs red" onAction="#onClearConnectivityLogs"/>
            <Button text="Recargar logs" onAction="#onReloadConnectivityLogs"/>
            <Button text="Copiar diagnostico" onAction="#onCopyConnectivityDiagnostics"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Logout" onAction="#onLogout"/>
          </HBox>

          <Label text="Ultimos errores de conectividad (5)"/>
          <TextArea fx:id="connectivityLogArea"
                    editable="false"
                    wrapText="true"
                    prefRowCount="7"
                    promptText="Sin errores recientes para este terminal."/>

          <Label fx:id="statusLabel" text="" />
        </VBox>
      </content>
    </ScrollPane>
  </center>

</BorderPane>
