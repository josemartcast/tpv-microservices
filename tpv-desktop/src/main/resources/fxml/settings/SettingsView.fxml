<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tpv.desktop.ui.settings.SettingsController"
            prefWidth="1100" prefHeight="650">

  <top>
    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 12;">
      <Label text="Settings" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    </HBox>
  </top>

  <center>
    <VBox spacing="12" style="-fx-padding: 12;">
      <Label text="API Base URL (Gateway)"/>
      <TextField fx:id="apiBaseUrlField" promptText="http://localhost:8080" prefWidth="420"/>

      <Label text="Terminal ID"/>
      <TextField fx:id="terminalIdField" promptText="TERMINAL-BARRA" prefWidth="420"/>

      <Label text="Nombre del negocio"/>
      <TextField fx:id="restaurantNameField" promptText="Restaurante EL GUSTO" prefWidth="420"/>

      <TitledPane text="Datos fiscales" expanded="false">
        <GridPane hgap="10" vgap="10" style="-fx-padding: 10;">
          <Label text="Razon social" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
          <TextField fx:id="fiscalLegalNameField"
                     promptText="Restaurante El Gusto S.L."
                     GridPane.rowIndex="0"
                     GridPane.columnIndex="1"
                     prefWidth="360"/>

          <Label text="NIF/CIF" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
          <TextField fx:id="fiscalTaxIdField"
                     promptText="B12345678"
                     GridPane.rowIndex="1"
                     GridPane.columnIndex="1"
                     prefWidth="200"/>

          <Label text="Direccion fiscal" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
          <TextField fx:id="fiscalAddressField"
                     promptText="Calle Mayor 1"
                     GridPane.rowIndex="2"
                     GridPane.columnIndex="1"
                     prefWidth="360"/>

          <Label text="Codigo postal" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
          <TextField fx:id="fiscalPostalCodeField"
                     promptText="28001"
                     GridPane.rowIndex="3"
                     GridPane.columnIndex="1"
                     prefWidth="120"/>

          <Label text="Ciudad" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
          <TextField fx:id="fiscalCityField"
                     promptText="Madrid"
                     GridPane.rowIndex="4"
                     GridPane.columnIndex="1"
                     prefWidth="220"/>

          <Label text="Provincia" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
          <TextField fx:id="fiscalProvinceField"
                     promptText="Madrid"
                     GridPane.rowIndex="5"
                     GridPane.columnIndex="1"
                     prefWidth="220"/>

          <Label text="Pais (ISO)" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
          <TextField fx:id="fiscalCountryField"
                     promptText="ES"
                     GridPane.rowIndex="6"
                     GridPane.columnIndex="1"
                     prefWidth="80"/>
        </GridPane>
      </TitledPane>

      <HBox spacing="10">
        <Button text="Guardar" onAction="#onSave"/>
        <Button text="Test conexion" onAction="#onTest"/>
        <Button text="Reset Terminal ID" onAction="#onResetTerminalId"/>
        <Button text="Liberar mis bloqueos" onAction="#onReleaseOwnLocks"/>
        <Button text="Abrir logs red" onAction="#onOpenConnectivityLogs"/>
        <Button text="Limpiar logs red" onAction="#onClearConnectivityLogs"/>
        <Button text="Recargar logs" onAction="#onReloadConnectivityLogs"/>
        <Button text="Copiar diagnostico" onAction="#onCopyConnectivityDiagnostics"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Logout" onAction="#onLogout"/>
      </HBox>

      <Label text="Ultimos errores de conectividad (5)"/>
      <TextArea fx:id="connectivityLogArea"
                editable="false"
                wrapText="true"
                prefRowCount="7"
                promptText="Sin errores recientes para este terminal."/>

      <Label fx:id="statusLabel" text="" />
    </VBox>
  </center>

</BorderPane>
