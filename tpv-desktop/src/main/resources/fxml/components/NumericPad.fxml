<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tpv.desktop.ui.components.NumericPadController"
      spacing="8" styleClass="num-pad" prefWidth="312" maxWidth="Infinity">
  <GridPane hgap="8" vgap="8" prefWidth="312" maxWidth="Infinity">
    <columnConstraints>
      <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS" fillWidth="true"/>
      <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS" fillWidth="true"/>
      <ColumnConstraints percentWidth="33.33" hgrow="ALWAYS" fillWidth="true"/>
    </columnConstraints>

    <Button text="1" onAction="#onDigit" userData="1" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
    <Button text="2" onAction="#onDigit" userData="2" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
    <Button text="3" onAction="#onDigit" userData="3" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="0" GridPane.columnIndex="2"/>

    <Button text="4" onAction="#onDigit" userData="4" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
    <Button text="5" onAction="#onDigit" userData="5" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
    <Button text="6" onAction="#onDigit" userData="6" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="1" GridPane.columnIndex="2"/>

    <Button text="7" onAction="#onDigit" userData="7" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
    <Button text="8" onAction="#onDigit" userData="8" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
    <Button text="9" onAction="#onDigit" userData="9" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="2" GridPane.columnIndex="2"/>

    <Button text="." onAction="#onDigit" userData="." styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
    <Button text="0" onAction="#onDigit" userData="0" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    <Button text="OK" onAction="#onOk" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="3" GridPane.columnIndex="2"/>

    <Button text="C" onAction="#onClear" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
    <Button text="Borrar" onAction="#onBackspace" styleClass="num-pad-btn" maxWidth="Infinity" GridPane.rowIndex="4" GridPane.columnIndex="1" GridPane.columnSpan="2"/>
  </GridPane>
</VBox>
