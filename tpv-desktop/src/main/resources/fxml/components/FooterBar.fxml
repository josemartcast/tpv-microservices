<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.tpv.desktop.tpv.ui.controllers.components.FooterBarController"
      alignment="CENTER_LEFT" spacing="8" styleClass="footerbar" prefHeight="64">
  <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
  <Button text="Caja" onAction="#onCaja" styleClass="footer-btn"/>
  <Button text="Historial" onAction="#onHistorial" styleClass="footer-btn"/>
  <Button text="Productos" onAction="#onProductos" styleClass="footer-btn"/>
  <Button text="Clientes" onAction="#onClientes" styleClass="footer-btn"/>
</HBox>

