<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.tpv.desktop.ui.sales.SalesController"
            fx:id="root"
            styleClass="sales-view"
            prefWidth="1000" prefHeight="650">

  <left>
    <VBox spacing="10" styleClass="sales-panel" prefWidth="240">
      <Label text="Categories" styleClass="sales-section-title"/>
      <ListView fx:id="categoriesList" prefWidth="220" VBox.vgrow="ALWAYS"/>
    </VBox>
  </left>

  <center>
    <VBox spacing="10" styleClass="sales-panel">
      <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Products" styleClass="sales-section-title"/>
        <TextField fx:id="productSearchField" promptText="Search product..." prefWidth="260"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="F2 New | F9 Send | F10 Efectivo | F11 Tarjeta | F12 Bizum | F6 Custom" styleClass="sales-hotkeys-hint"/>
        <Button fx:id="newTicketBtn" text="New ticket" onAction="#onNewTicket" styleClass="touch-btn"/>
      </HBox>

      <ScrollPane fitToWidth="true" fitToHeight="true">
        <content>
          <FlowPane fx:id="productsPane" hgap="10" vgap="10" prefWrapLength="800"/>
        </content>
      </ScrollPane>

      <Label fx:id="errorLabel" text="" styleClass="sales-feedback sales-feedback-info"/>
    </VBox>
  </center>

  <right>
    <VBox spacing="10" styleClass="sales-panel" prefWidth="420">
      <Label text="Current ticket" styleClass="sales-section-title"/>

      <Label fx:id="ticketInfoLabel" text="No ticket"/>

      <TableView fx:id="linesTable" prefHeight="420" VBox.vgrow="ALWAYS">
        <columns>
          <TableColumn fx:id="colName" text="Product" prefWidth="170"/>
          <TableColumn fx:id="colQty" text="Qty" prefWidth="60"/>
          <TableColumn fx:id="colUnit" text="EUR/u" prefWidth="70"/>
          <TableColumn fx:id="colTotal" text="Total" prefWidth="70"/>
        </columns>
      </TableView>

      <HBox spacing="10" alignment="CENTER_RIGHT">
        <Label text="TOTAL:" style="-fx-font-weight: bold;"/>
        <Label fx:id="totalLabel" text="0.00" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
      </HBox>

      <Separator/>

      <HBox spacing="10">
        <Button fx:id="sendBtn" text="Send (F9)" onAction="#onSend" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="touch-btn touch-btn-primary"/>
        <Button fx:id="payCashBtn" text="Efectivo (F10)" onAction="#onPayCash" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="touch-btn touch-btn-success"/>
      </HBox>
      <HBox spacing="10">
        <Button fx:id="payCardBtn" text="Tarjeta (F11)" onAction="#onPayCard" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="touch-btn touch-btn-success"/>
        <Button fx:id="payBizumBtn" text="Bizum (F12)" onAction="#onPayBizum" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="touch-btn touch-btn-success"/>
      </HBox>
      <HBox spacing="10">
        <Button fx:id="payCustomBtn" text="Custom pay (F6)" onAction="#onPayCustom" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="touch-btn"/>
      </HBox>

      <HBox spacing="10">
        <Button fx:id="cancelBtn" text="Cancel (Esc)" onAction="#onCancel" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="touch-btn touch-btn-danger"/>
        <Button fx:id="refreshBtn" text="Refresh (F5)" onAction="#onRefresh" maxWidth="Infinity" HBox.hgrow="ALWAYS" styleClass="touch-btn"/>
      </HBox>
    </VBox>
  </right>

</BorderPane>
